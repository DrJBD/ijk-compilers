`title`body`text!("Escapes";("C writes a newline as ",(`c$92),"n, and Windows ends a line with ",(`c$92),"r",(`c$92),"n.\nThis file really does end its lines that way.\nA \"quoted\" word, a tab:	here, an em dash — and an emoji 😀.");("Escapes",(`c$13),"\n",(`c$13),"\nC writes a newline as ",(`c$92),"n, and Windows ends a line with ",(`c$92),"r",(`c$92),"n.",(`c$13),"\nThis file really does end its lines that way.",(`c$13),"\nA \"quoted\" word, a tab:	here, an em dash — and an emoji 😀.",(`c$13),"\n"))
